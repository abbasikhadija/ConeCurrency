# Copy to web/.env and choose a private admin password before running.
ADMIN_PASSWORD=
BRIDGE_PORT=3001
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
# Ubuntu: bridge owns/restarts the C executable for admin-controlled rounds.
MANAGE_BACKEND=1
C_SERVER_PATH=../ticket-server
# Only set for an external C server when this matches its --tickets value.
# BACKEND_STOCK=50
